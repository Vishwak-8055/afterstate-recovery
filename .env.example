# Copy to .env and fill in. Placeholders only: never commit real values.
# Use a URL-safe password (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me-url-safe-secret
# Public origin users type in the browser (used for the CSRF origin allow-list).
PUBLIC_ORIGIN=http://localhost:3000
WEB_PORT=3000
# Only for the optional TLS reverse-proxy profile (docker compose --profile proxy up):
PUBLIC_HOST=localhost
# Optional overrides (defaults shown). See docs/environment.md for every setting.
# AFTERSTATE_MAX_ARTIFACT_BYTES=2147483648
# AFTERSTATE_ALLOW_REGISTRATION=true
